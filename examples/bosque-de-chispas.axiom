          {
            "id": "node_b0570567b0",
            "name": "Jugador",
            "type": "CharacterBody2D",
            "x": -380,
            "y": 170,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "visible": true,
            "zIndex": 5,
            "props": {
              "width": 34,
              "height": 48,
              "color": "#4ade80",
              "bodyVisual": "none",
              "group": "player"
            },
            "script": "_ready() {\n  this.speed = 315\n  this.jump_force = 735\n  this.coyote = 0\n  this.buffer = 0\n  this.invuln = 0\n  this.facing = 1\n  Game.on('damage', () => this.hurt())\n}\n\n_physics_process(dt) {\n  const dir = Input.get_axis('left', 'right')\n  this.velocity.x = dir * this.speed\n  if (dir !== 0) {\n    this.facing = dir\n    const sprite = this.get_node('Aspecto')\n    if (sprite) sprite.props.flipX = dir < 0\n  }\n\n  if (this.on_floor) this.coyote = 0.11\n  else this.coyote = Math.max(0, this.coyote - dt)\n\n  if (Input.is_action_just_pressed('jump')) this.buffer = 0.13\n  else this.buffer = Math.max(0, this.buffer - dt)\n\n  this.velocity.y += this.gravity * dt\n  if (this.buffer > 0 && this.coyote > 0) {\n    this.velocity.y = -this.jump_force\n    this.buffer = 0\n    this.coyote = 0\n    this.play_sound('jump')\n  }\n\n  this.move_and_slide(dt)\n\n  if (this.invuln > 0) {\n    this.invuln -= dt\n    const sprite = this.get_node('Aspecto')\n    if (sprite) sprite.visible = Math.floor(this.invuln * 18) % 2 === 0\n  } else {\n    const sprite = this.get_node('Aspecto')\n    if (sprite) sprite.visible = true\n  }\n\n  if (this.y > 430) this.hurt()\n}\n\nhurt() {\n  if (this.invuln > 0) return\n  this.invuln = 1.35\n  this.play_sound('hit')\n  this.shake(10, 0.32)\n  Game.lives = Math.max(0, Game.lives - 1)\n  if (Game.lives <= 0) {\n    Game.game_over(false, 'Las sombras del bosque te atraparon')\n    return\n  }\n  this.x = -380\n  this.y = 120\n  this.velocity.x = 0\n  this.velocity.y = 0\n}",
