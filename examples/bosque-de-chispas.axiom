          {
            "id": "node_f9d4ed4b7b",
            "name": "Chispa 1",
            "type": "Area2D",
            "x": -520,
            "y": 80,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "visible": true,
            "zIndex": 0,
            "props": {
              "width": 34,
              "height": 34,
              "group": "coin",
              "debug": false
            },
            "script": "_ready() {\n  this.taken = false\n}\n\n_physics_process() {\n  if (this.taken) return\n  if (this.overlaps('player').length > 0) {\n    this.taken = true\n    Game.add_score(10)\n    this.play_sound('coin')\n    Game.emit('coin')\n    this.queue_free()\n  }\n}",
