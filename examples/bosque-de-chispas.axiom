          {
            "id": "node_4682503a5b",
            "name": "Slime patrulla",
            "type": "Area2D",
            "x": -90,
            "y": 205,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "visible": true,
            "zIndex": 0,
            "props": {
              "width": 54,
              "height": 42,
              "group": "enemy",
              "debug": false
            },
            "script": "_ready() {\n  this.dir = 1\n  this.speed = 58\n  this.min_x = this.x - 95\n  this.max_x = this.x + 95\n}\n\n_physics_process(dt) {\n  this.x += this.dir * this.speed * dt\n  if (this.x < this.min_x || this.x > this.max_x) this.dir *= -1\n  const sprite = this.get_node('Slime')\n  if (sprite) sprite.props.flipX = this.dir < 0\n  if (this.overlaps('player').length > 0) Game.emit('damage')\n}",
