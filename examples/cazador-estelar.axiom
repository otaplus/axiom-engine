              "waitTime": 0.85,
              "autostart": true,
              "oneShot": false
            },
            "script": "_ready() {\n  this.count = 0\n}\n\n_on_timeout() {\n  this.count += 1\n  const x = rand(-410, 410)\n  const enemy = this.spawn('Enemigo', x, -310)\n  if (enemy) enemy.speed = 72 + Math.min(140, this.count * 4)\n}",
