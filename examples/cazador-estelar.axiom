          {
            "id": "node_f856b5993e",
            "name": "Nave",
            "type": "CharacterBody2D",
            "x": 0,
            "y": 190,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "visible": true,
            "zIndex": 6,
            "props": {
              "width": 34,
              "height": 42,
              "color": "#4ade80",
              "bodyVisual": "none",
              "group": "player"
            },
            "script": "_ready() {\n  this.speed = 380\n  this.invuln = 0\n  this.auto = 0.2\n  Game.on('damage', () => this.hurt())\n}\n\n_process(dt) {\n  this.auto -= dt\n  if (this.auto <= 0) {\n    this.auto = 0.2\n    this.shoot()\n  }\n}\n\n_physics_process(dt) {\n  const dirX = Input.get_axis('left', 'right')\n  const dirY = Input.get_axis('up', 'down')\n  this.velocity.x = dirX * this.speed\n  this.velocity.y = dirY * this.speed\n  this.move_and_slide(dt)\n  this.x = clamp(this.x, -430, 430)\n  this.y = clamp(this.y, -220, 225)\n  if (this.invuln > 0) {\n    this.invuln -= dt\n    const sprite = this.get_node('Aspecto')\n    if (sprite) sprite.visible = Math.floor(this.invuln * 16) % 2 === 0\n  } else {\n    const sprite = this.get_node('Aspecto')\n    if (sprite) sprite.visible = true\n  }\n}\n\nshoot() {\n  this.spawn('Bala', this.x, this.y - 34)\n  this.play_sound('laser', 0.35)\n}\n\nhurt() {\n  if (this.invuln > 0) return\n  this.invuln = 1.5\n  this.shake(15, 0.4)\n  this.play_sound('hit')\n  Game.lives = Math.max(0, Game.lives - 1)\n  if (Game.lives <= 0) Game.game_over(false, 'La nave fue destruida en el cinturón de asteroides')\n}",
            "children": [
              {
                "id": "node_38faa1e30e",
                "name": "Aspecto",
                "type": "Sprite2D",
                "x": 0,
                "y": 0,
                "rotation": 0,
                "scaleX": 1,
                "scaleY": 1,
                "visible": true,
                "zIndex": 0,
                "props": {
                  "assetId": "ship",
                  "width": 70,
                  "height": 70,
                  "tint": "#ffffff",
                  "opacity": 1,
                  "flipX": false,
                  "flipY": false,
                  "glow": 14,
                  "glowColor": "#38bdf8",
                  "shadow": false
                },
                "children": []
              },
