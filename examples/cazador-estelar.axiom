            "children": [
              {
                "id": "node_6c8707fcc4",
                "name": "Bala",
                "type": "Area2D",
                "x": 0,
                "y": 0,
                "rotation": 0,
                "scaleX": 1,
                "scaleY": 1,
                "visible": false,
                "zIndex": 0,
                "template": true,
                "props": {
                  "width": 14,
                  "height": 26,
                  "group": "bullet",
                  "debug": false
                },
                "script": "_ready() {\n  this.velocity.y = -680\n}\n\n_physics_process(dt) {\n  this.y += this.velocity.y * dt\n  if (this.y < -330) {\n    this.queue_free()\n    return\n  }\n  const hits = this.overlaps('enemy')\n  if (hits.length > 0) {\n    for (const enemy of hits) {\n      Game.add_score(5)\n      enemy.queue_free()\n    }\n    this.play_sound('explosion', 0.4)\n    this.queue_free()\n  }\n}",
                "children": [
                  {
                    "id": "node_e2573ea7bb",
                    "name": "Chispa",
                    "type": "Sprite2D",
                    "x": 0,
                    "y": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1,
                    "visible": true,
                    "zIndex": 0,
                    "props": {
                      "assetId": "bolt",
                      "width": 24,
                      "height": 30,
                      "tint": "#ffffff",
                      "opacity": 1,
                      "flipX": false,
                      "flipY": false,
                      "glow": 12,
                      "glowColor": "#e0f2fe",
                      "shadow": false
                    },
                    "children": []
                  }
                ]
              },
              {
                "id": "node_3c03ba5af5",
                "name": "Enemigo",
                "type": "Area2D",
                "x": 0,
                "y": 0,
                "rotation": 0,
                "scaleX": 1,
                "scaleY": 1,
                "visible": false,
                "zIndex": 0,
                "template": true,
                "props": {
                  "width": 46,
                  "height": 46,
                  "group": "enemy",
                  "debug": false
                },
                "script": "_ready() {\n  this.speed = 85\n  this.drift = rand(-35, 35)\n  this.spin = rand(-1, 1)\n}\n\n_physics_process(dt) {\n  this.y += this.speed * dt\n  this.x += this.drift * dt\n  this.rotation += this.spin * 35 * dt\n  if (this.y > 330) {\n    this.queue_free()\n    return\n  }\n  if (this.overlaps('player').length > 0) {\n    this.play_sound('hit')\n    Game.emit('damage')\n    this.queue_free()\n  }\n}",
                "children": [
                  {
                    "id": "node_e35f44435e",
                    "name": "Alien",
                    "type": "Sprite2D",
                    "x": 0,
                    "y": 0,
